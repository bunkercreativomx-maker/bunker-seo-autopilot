# Bunker SEO Autopilot — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.

# PocketBase public URL (browser + server). Fixed infrastructure, not a secret.
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8095
# Server-side alias (optional; falls back to NEXT_PUBLIC_POCKETBASE_URL).
POCKETBASE_URL=http://127.0.0.1:8095

# The web app does NOT use PocketBase superuser credentials. Every request
# runs with the signed-in user's own token; privileged/validated operations
# run inside PocketBase (pb_hooks/). See docs/AUTH-ARCHITECTURE.md.
# PB_ADMIN_EMAIL / PB_ADMIN_PASSWORD belong ONLY to trusted infrastructure
# (workers, migrations, local tests) — never set them in Vercel.

# Phase 3 strategy worker. "null" disables all model calls while preserving
# deterministic strategy generation; "openai" requires OPENAI_API_KEY.
AI_PROVIDER=null
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
# Optional task override (falls back to AI_MODEL).
AI_MODEL_KEYWORD_DISCOVERY=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# Per-strategy hard budgets. A job may request lower values, never higher ones.
MAX_AI_CALLS_PER_STRATEGY=4
MAX_KEYWORDS_PER_STRATEGY=200
MAX_CLUSTERS=50
MAX_OPPORTUNITIES=100

# Optional accounting rates in USD per million tokens. Set these to the current
# rates for the configured model; zero records tokens but leaves cost at zero.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
