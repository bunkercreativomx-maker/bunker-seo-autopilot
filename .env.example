# Bunker SEO Autopilot — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.

# PocketBase public URL (browser + server). Fixed infrastructure, not a secret.
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8095
# Server-side alias (optional; falls back to NEXT_PUBLIC_POCKETBASE_URL).
POCKETBASE_URL=http://127.0.0.1:8095

# PocketBase superuser credentials — used ONLY server-side for:
#   - writing activity_logs (createRule is null)
#   - updating the organization (updateRule is null)
#   - inviting users (users.createRule requires admin)
# These are SECRETS. Never expose to the client.
PB_ADMIN_EMAIL=admin@seo.autopilot
PB_ADMIN_PASSWORD=change-me
